---
// src/layouts/Layout.astro
// ═══════════════════════════════════════════════════════════════
// Общий макет для всех страниц сайта
// Содержит: <head>, Header, Footer, подключение стилей
// ═══════════════════════════════════════════════════════════════

// Пропсы компонента
interface Props {
  title: string;           // Заголовок страницы (для <title>)
  description?: string;    // Мета-описание для SEO
}

const { 
  title, 
  description = 'MTechCore — разработка, обзоры, технологии. Личный хаб техноблогера.' 
} = Astro.props;

// Полный заголовок страницы
const fullTitle = title === 'Главная' 
  ? 'MTechCore | Losungs — Технологии и Разработка' 
  : `${title} | MTechCore`;
---

<!doctype html>
<html lang="ru" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Фавикон -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Шрифты (опционально - можно подключить Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <!-- Open Graph для соцсетей -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <title>{fullTitle}</title>
  </head>
  
  <body class="bg-brand-bg text-brand-text min-h-screen font-sans antialiased">
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- HEADER -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <header class="sticky top-0 z-50 border-b border-brand-border bg-brand-bg/80 backdrop-blur-md">
      <nav class="container mx-auto px-4 py-4 flex items-center justify-between max-w-5xl">
        
        <!-- Логотип / Название -->
        <a href="/" class="flex items-center gap-2 group">
          <!-- Иконка-логотип -->
          <span class="text-2xl">⚡</span>
          <!-- Название -->
          <span class="font-bold text-lg">
            <span class="text-brand-accent">MTechCore</span>
            <span class="text-brand-text-dim mx-1">|</span>
            <span class="text-brand-secondary">Losungs</span>
          </span>
        </a>
        
        <!-- Навигация -->
        <div class="flex items-center gap-6">
          <a 
            href="/" 
            class="text-brand-text-dim hover:text-brand-accent transition-colors text-sm font-medium"
          >
            Главная
          </a>
          <a 
            href="/blog/" 
            class="text-brand-text-dim hover:text-brand-accent transition-colors text-sm font-medium"
          >
            Блог
          </a>
          <a 
            href="https://github.com/mtechcore" 
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-text-dim hover:text-brand-text transition-colors"
            aria-label="GitHub"
          >
            <!-- GitHub иконка (inline SVG) -->
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>
      </nav>
    </header>
    
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ОСНОВНОЙ КОНТЕНТ -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <main class="container mx-auto px-4 py-8 max-w-5xl">
      <slot />
    </main>
    
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- FOOTER -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <footer class="border-t border-brand-border mt-16">
      <div class="container mx-auto px-4 py-8 max-w-5xl">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          
          <!-- Копирайт -->
          <p class="text-brand-text-dim text-sm">
            © {new Date().getFullYear()} MTechCore | Losungs. 
            <span class="hidden sm:inline">Собрано на Astro ⚡</span>
          </p>
          
          <!-- Соц. ссылки -->
          <div class="flex items-center gap-4">
            <!-- GitHub -->
            <a 
              href="https://github.com/mtechcore" 
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-text-dim hover:text-brand-accent transition-colors"
              aria-label="GitHub"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
            </a>
            
            <!-- YouTube -->
            <a 
              href="https://youtube.com/@mtechcore" 
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-text-dim hover:text-red-500 transition-colors"
              aria-label="YouTube"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
            
            <!-- Telegram (опционально) -->
            <a 
              href="https://t.me/mtechcore" 
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-text-dim hover:text-blue-400 transition-colors"
              aria-label="Telegram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ═══════════════════════════════════════════════════════════════ */
  /* Глобальные стили */
  /* ═══════════════════════════════════════════════════════════════ */
  
  /* Плавный скролл */
  html {
    scroll-behavior: smooth;
  }
  
  /* Стили для скроллбара (Webkit) */
  ::-webkit-scrollbar {
    width: 8px;
  }
  
  ::-webkit-scrollbar-track {
    background: #0a0a0f;
  }
  
  ::-webkit-scrollbar-thumb {
    background: #27272a;
    border-radius: 4px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: #3f3f46;
  }
  
  /* Выделение текста */
  ::selection {
    background: rgba(0, 212, 255, 0.3);
    color: #fff;
  }
</style>

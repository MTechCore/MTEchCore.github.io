---
// src/pages/blog/[...slug].astro
// ═══════════════════════════════════════════════════════════════
// Динамическая страница для отдельной статьи
// [...slug] позволяет обрабатывать пути любой вложенности
// ═══════════════════════════════════════════════════════════════

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// ─────────────────────────────────────────────────────────────
// Генерация статических путей для всех статей
// ─────────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

// Получаем статью из пропсов
const { post } = Astro.props;

// Рендерим контент Markdown
const { Content } = await post.render();

// Форматирование даты
function formatDate(date: Date): string {
  return date.toLocaleDateString('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={post.data.title} description={post.data.description}>
  
  <article class="py-8 max-w-3xl mx-auto">
    
    <!-- Шапка статьи -->
    <header class="mb-8 pb-8 border-b border-brand-border">
      <!-- Навигация назад -->
      <a 
        href="/blog/" 
        class="inline-flex items-center gap-2 text-brand-text-dim hover:text-brand-accent transition-colors text-sm mb-6"
      >
        <span>←</span>
        <span>Назад к блогу</span>
      </a>
      
      <!-- Заголовок -->
      <h1 class="text-3xl md:text-4xl font-bold text-brand-text mb-4 leading-tight">
        {post.data.title}
      </h1>
      
      <!-- Мета-информация -->
      <div class="flex flex-wrap items-center gap-4 text-sm">
        <time 
          datetime={post.data.pubDate.toISOString()}
          class="text-brand-text-dim font-mono"
        >
          {formatDate(post.data.pubDate)}
        </time>
        
        {post.data.updatedDate && (
          <span class="text-brand-text-dim">
            (обновлено: {formatDate(post.data.updatedDate)})
          </span>
        )}
        
        {post.data.tags.length > 0 && (
          <div class="flex gap-2">
            {post.data.tags.map((tag) => (
              <span class="px-2 py-0.5 text-xs font-mono bg-brand-bg-light rounded text-brand-accent border border-brand-border">
                #{tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>
    
    <!-- Контент статьи -->
    <div class="prose prose-invert prose-lg max-w-none">
      <Content />
    </div>
    
    <!-- Подвал статьи -->
    <footer class="mt-12 pt-8 border-t border-brand-border">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <a 
          href="/blog/" 
          class="text-brand-accent hover:underline"
        >
          ← Все статьи
        </a>
        
        <p class="text-brand-text-dim text-sm">
          Нашёл ошибку? 
          <a 
            href={`https://github.com/mtechcore/mtechcore.github.io/edit/main/src/content/blog/${post.slug}.md`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-accent hover:underline"
          >
            Исправь на GitHub
          </a>
        </p>
      </div>
    </footer>
    
  </article>
  
</Layout>

<!-- Стили для Markdown контента -->
<style is:global>
  /* ═══════════════════════════════════════════════════════════ */
  /* Стили для prose (Markdown контента) */
  /* ═══════════════════════════════════════════════════════════ */
  
  .prose {
    color: #e4e4e7;
  }
  
  .prose h2 {
    color: #fff;
    font-weight: 700;
    margin-top: 2em;
    margin-bottom: 0.75em;
    border-bottom: 1px solid #27272a;
    padding-bottom: 0.5em;
  }
  
  .prose h3 {
    color: #fff;
    font-weight: 600;
    margin-top: 1.5em;
  }
  
  .prose a {
    color: #00d4ff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .prose a:hover {
    color: #0099cc;
  }
  
  .prose code {
    background: #12121a;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
    color: #00d4ff;
  }
  
  .prose pre {
    background: #12121a !important;
    border: 1px solid #27272a;
    border-radius: 8px;
    padding: 1em;
    overflow-x: auto;
  }
  
  .prose pre code {
    background: none;
    padding: 0;
    color: inherit;
  }
  
  .prose blockquote {
    border-left: 3px solid #a855f7;
    padding-left: 1em;
    color: #a1a1aa;
    font-style: italic;
  }
  
  .prose ul, .prose ol {
    padding-left: 1.5em;
  }
  
  .prose li::marker {
    color: #00d4ff;
  }
  
  .prose img {
    border-radius: 8px;
    border: 1px solid #27272a;
  }
  
  .prose hr {
    border-color: #27272a;
  }
  
  .prose table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .prose th, .prose td {
    border: 1px solid #27272a;
    padding: 0.5em 1em;
  }
  
  .prose th {
    background: #12121a;
  }
</style>

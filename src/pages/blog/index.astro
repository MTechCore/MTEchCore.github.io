---
// src/pages/blog/index.astro
// ═══════════════════════════════════════════════════════════════
// Страница со списком всех статей блога
// ═══════════════════════════════════════════════════════════════

import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Загружаем все статьи (кроме черновиков)
const allPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Сортируем по дате (новые сверху)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Хелпер для форматирования даты
function formatDate(date: Date): string {
  return date.toLocaleDateString('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title="Блог" description="Статьи о разработке, технологиях и гаджетах от MTechCore">
  
  <!-- Заголовок страницы -->
  <section class="py-8">
    <h1 class="text-3xl md:text-4xl font-bold text-brand-text mb-4">
      Блог
    </h1>
    <p class="text-brand-text-dim max-w-2xl">
      Статьи о разработке, технологиях, гаджетах и всём, что меня интересует. 
      Без воды, с кодом и примерами.
    </p>
  </section>
  
  <!-- Список статей -->
  <section class="py-8">
    {sortedPosts.length > 0 ? (
      <div class="space-y-6">
        {sortedPosts.map((post) => (
          <article class="group">
            <a 
              href={`/blog/${post.slug}/`}
              class="block p-6 bg-brand-bg-light border border-brand-border rounded-xl hover:border-brand-accent/50 transition-all"
            >
              <div class="flex flex-col gap-3">
                <!-- Дата и теги -->
                <div class="flex flex-wrap items-center gap-3">
                  <time 
                    datetime={post.data.pubDate.toISOString()}
                    class="text-brand-text-dim text-sm font-mono"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  {post.data.tags.length > 0 && (
                    <div class="flex gap-2">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="px-2 py-0.5 text-xs font-mono bg-brand-bg rounded text-brand-accent border border-brand-border">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                
                <!-- Заголовок -->
                <h2 class="text-xl md:text-2xl font-semibold text-brand-text group-hover:text-brand-accent transition-colors">
                  {post.data.title}
                </h2>
                
                <!-- Описание -->
                <p class="text-brand-text-dim leading-relaxed">
                  {post.data.description}
                </p>
                
                <!-- Читать далее -->
                <span class="text-brand-accent font-mono text-sm group-hover:underline">
                  Читать статью →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-6xl mb-4">📝</p>
        <h2 class="text-xl font-semibold text-brand-text mb-2">Пока тут пусто</h2>
        <p class="text-brand-text-dim">Статьи скоро появятся!</p>
      </div>
    )}
  </section>
  
</Layout>
